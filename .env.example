# ============================================================
# AI股神团队 1.0 · 环境变量样例
# 用法：cp .env.example .env && 填入真实值（.env 已在 .gitignore 中）
# ============================================================

# --- 飞书通知（敏感信息不要提交到 Git） ---
FEISHU_NOTIFY_USER_ID=
FEISHU_NOTIFY_CHAT_ID=
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=
FEISHU_BASE_URL=

# --- LLM（豆包 / 火山方舟 Ark，OpenAI 兼容） ---
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# --- 数据源限流（防 IP 封禁） ---
# 每秒允许的行情/K线请求数；设为 0 关闭限流
FETCH_RATE_PER_SEC=8
# 突发容量（桶深）
FETCH_RATE_BURST=16

# --- 运行时状态目录（股票池/候选池外置，不随项目分发） ---
# AI_STOCK_WATCHLIST_FILE=
# AI_STOCK_STATE_DIR=
# AI_STOCK_LOG_DIR=

# --- 本地通达信日K兜底 ---
# TDX_ROOT=D:\new_tdx

# --- 可选依赖开关 ---
# CRAWL4AI_ENABLED=0
# TUSHARE_TOKEN=

# --- 日志 ---
# LOG_LEVEL=INFO
# LOG_FILE=
